<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="740.0" prefWidth="1080.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pbl4.app.controller.AdminController"
            stylesheets="@../style/theme.css"
            style="-fx-background-color: #f8fafc;">

    <!-- Header Quản Trị Hiện Đại -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="62.0" spacing="16.0"
              style="-fx-background-color: #0f172a; -fx-padding: 10 24;" BorderPane.alignment="CENTER">
            
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <StackPane prefHeight="38.0" prefWidth="38.0"
                           style="-fx-background-color: linear-gradient(to bottom right, #f59e0b, #d97706); -fx-background-radius: 10;">
                    <Label text="👑" textFill="WHITE">
                        <font><Font size="18.0" /></font>
                    </Label>
                </StackPane>
                <VBox alignment="CENTER_LEFT" spacing="1.0">
                    <Label text="PBL4 ADMIN DASHBOARD" textFill="#f59e0b">
                        <font>
                            <Font name="System Bold" size="16.0" />
                        </font>
                    </Label>
                    <Label text="Quản trị hệ thống, dữ liệu MySQL và nhật ký truyền file" textFill="#94a3b8">
                        <font><Font size="10.5" /></font>
                    </Label>
                </VBox>
            </HBox>

            <Separator orientation="VERTICAL" prefHeight="26.0" style="-fx-opacity: 0.25;" />

            <HBox alignment="CENTER_LEFT" spacing="8.0"
                  style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-background-radius: 20; -fx-padding: 4 12;">
                <Label text="🛡️" textFill="#fbbf24" />
                <Label fx:id="lblAdminUser" text="Quản trị viên: ..." textFill="#f1f5f9">
                    <font>
                        <Font name="System Bold" size="12.5" />
                    </font>
                </Label>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Button fx:id="btnGoToChat" mnemonicParsing="false" onAction="#onGoToChat"
                        styleClass="button, btn-primary"
                        text="💬 Vào Phòng Chat" />
                <Button fx:id="btnLogout" mnemonicParsing="false" onAction="#onLogout"
                        styleClass="button, btn-danger"
                        text="Đăng Xuất 🚪" />
            </HBox>
        </HBox>
    </top>

    <!-- Center: TabPane 4 chức năng quản trị -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: transparent;">
            
            <!-- TAB 1: QUẢN LÝ TÀI KHOẢN -->
            <Tab text="👤 Quản Lý Tài Khoản">
                <VBox spacing="12.0" style="-fx-padding: 18;">
                    <!-- Thanh công cụ -->
                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="card" style="-fx-padding: 12 16;">
                        <TextField fx:id="txtSearchUser" promptText="🔍 Tìm nhanh theo tên đăng nhập..." prefWidth="260.0"
                                   styleClass="text-field" />
                        <Button mnemonicParsing="false" onAction="#onSearchUser"
                                styleClass="button, btn-primary"
                                text="Tìm Kiếm" />
                        <Button mnemonicParsing="false" onAction="#onRefreshUsers"
                                styleClass="button, btn-secondary"
                                text="🔄 Làm Mới" />
                        
                        <Separator orientation="VERTICAL" prefHeight="25.0" />

                        <Button mnemonicParsing="false" onAction="#onAddUser"
                                styleClass="button, btn-success"
                                text="➕ Thêm User" />
                        <Button mnemonicParsing="false" onAction="#onEditUserRole"
                                styleClass="button, btn-warning"
                                text="⚙ Đổi Quyền Role" />
                        <Button mnemonicParsing="false" onAction="#onResetPassword"
                                styleClass="button, btn-secondary"
                                text="🔑 Reset Mật Khẩu" />
                        <Button mnemonicParsing="false" onAction="#onDeleteUser"
                                styleClass="button, btn-danger"
                                text="🗑 Xóa User" />
                    </HBox>

                    <!-- Bảng TableView Users -->
                    <TableView fx:id="tvUsers" VBox.vgrow="ALWAYS" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colUserId" prefWidth="60.0" text="ID" />
                            <TableColumn fx:id="colUserUsername" prefWidth="180.0" text="Tên Đăng Nhập" />
                            <TableColumn fx:id="colUserRole" prefWidth="130.0" text="Vai Trò (Role)" />
                            <TableColumn fx:id="colUserStatus" prefWidth="130.0" text="Trạng Thái" />
                            <TableColumn fx:id="colUserCreatedAt" prefWidth="200.0" text="Ngày Tạo" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>

            <!-- TAB 2: QUẢN LÝ NHẬT KÝ HOẠT ĐỘNG -->
            <Tab text="📜 Nhật Ký Hoạt Động (Logs)">
                <VBox spacing="12.0" style="-fx-padding: 18;">
                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="card" style="-fx-padding: 12 16;">
                        <TextField fx:id="txtSearchLog" promptText="🔍 Lọc theo Username hoặc Hành động..." prefWidth="300.0"
                                   styleClass="text-field" />
                        <Button mnemonicParsing="false" onAction="#onSearchLog"
                                styleClass="button, btn-primary"
                                text="Lọc" />
                        <Button mnemonicParsing="false" onAction="#onRefreshLogs"
                                styleClass="button, btn-secondary"
                                text="🔄 Làm Mới" />
                        <Separator orientation="VERTICAL" prefHeight="25.0" />
                        <Button mnemonicParsing="false" onAction="#onDeleteLog"
                                styleClass="button, btn-danger"
                                text="🗑 Xóa Bản Ghi Log" />
                    </HBox>

                    <TableView fx:id="tvActivityLogs" VBox.vgrow="ALWAYS" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colLogId" prefWidth="60.0" text="ID" />
                            <TableColumn fx:id="colLogUsername" prefWidth="150.0" text="Tài Khoản" />
                            <TableColumn fx:id="colLogAction" prefWidth="130.0" text="Hành Động" />
                            <TableColumn fx:id="colLogDetails" prefWidth="350.0" text="Chi Tiết Hoạt Động" />
                            <TableColumn fx:id="colLogCreatedAt" prefWidth="180.0" text="Thời Gian" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>

            <!-- TAB 3: LỊCH SỬ TIN NHẮN CHAT -->
            <Tab text="💬 Lịch Sử Tin Nhắn">
                <VBox spacing="12.0" style="-fx-padding: 18;">
                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="card" style="-fx-padding: 12 16;">
                        <TextField fx:id="txtSearchChat" promptText="🔍 Lọc theo người gửi, người nhận, nội dung..." prefWidth="340.0"
                                   styleClass="text-field" />
                        <Button mnemonicParsing="false" onAction="#onSearchChat"
                                styleClass="button, btn-primary"
                                text="Lọc Tin Nhắn" />
                        <Button mnemonicParsing="false" onAction="#onRefreshChat"
                                styleClass="button, btn-secondary"
                                text="🔄 Làm Mới" />
                    </HBox>

                    <TableView fx:id="tvChatMessages" VBox.vgrow="ALWAYS" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colChatId" prefWidth="60.0" text="ID" />
                            <TableColumn fx:id="colChatSender" prefWidth="140.0" text="Người Gửi" />
                            <TableColumn fx:id="colChatReceiver" prefWidth="140.0" text="Người Nhận" />
                            <TableColumn fx:id="colChatMessage" prefWidth="380.0" text="Nội Dung Tin Nhắn (Đã mã hóa AES trong DB)" />
                            <TableColumn fx:id="colChatCreatedAt" prefWidth="180.0" text="Thời Gian" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>

            <!-- TAB 4: LỊCH SỬ TRUYỀN FILE P2P -->
            <Tab text="📁 Lịch Sử Truyền File">
                <VBox spacing="12.0" style="-fx-padding: 18;">
                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="card" style="-fx-padding: 12 16;">
                        <TextField fx:id="txtSearchFile" promptText="🔍 Lọc theo tên file, người gửi/nhận..." prefWidth="320.0"
                                   styleClass="text-field" />
                        <Button mnemonicParsing="false" onAction="#onSearchFile"
                                styleClass="button, btn-primary"
                                text="Lọc" />
                        <Button mnemonicParsing="false" onAction="#onRefreshFiles"
                                styleClass="button, btn-secondary"
                                text="🔄 Làm Mới" />
                    </HBox>

                    <TableView fx:id="tvFileTransfers" VBox.vgrow="ALWAYS" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colFileId" prefWidth="60.0" text="ID" />
                            <TableColumn fx:id="colFileSender" prefWidth="130.0" text="Người Gửi" />
                            <TableColumn fx:id="colFileReceiver" prefWidth="130.0" text="Người Nhận" />
                            <TableColumn fx:id="colFileName" prefWidth="250.0" text="Tên Tệp Tin" />
                            <TableColumn fx:id="colFileSize" prefWidth="110.0" text="Kích Thước" />
                            <TableColumn fx:id="colFileStatus" prefWidth="100.0" text="Trạng Thái" />
                            <TableColumn fx:id="colFileCreatedAt" prefWidth="180.0" text="Thời Gian" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>

        </TabPane>
    </center>
</BorderPane>
