<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="550.0" prefWidth="440.0" spacing="14.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pbl4.app.controller.LoginController"
      style="-fx-background-color: #f8fafc; -fx-padding: 30 35;">

    <!-- Logo & Tiêu đề -->
    <VBox alignment="CENTER" spacing="4.0">
        <Label text="PBL4 Chat &amp; P2P" textFill="#1e293b">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <Label text="Hệ thống Trò chuyện &amp; Truyền File Ngang Hàng" textFill="#64748b">
            <font>
                <Font size="13.0" />
            </font>
        </Label>
    </VBox>

    <!-- Form đăng nhập -->
    <VBox spacing="12.0" style="-fx-background-color: #ffffff; -fx-padding: 22; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
        
        <VBox spacing="4.0">
            <Label text="Tên đăng nhập (Username):" textFill="#334155">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Label>
            <TextField fx:id="txtUsername" promptText="Nhập tên đăng nhập..."
                       style="-fx-pref-height: 38; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-padding: 0 10; -fx-font-size: 13;" />
        </VBox>

        <VBox spacing="4.0">
            <Label text="Mật khẩu (Password):" textFill="#334155">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Label>
            <PasswordField fx:id="txtPassword" promptText="Nhập mật khẩu..."
                           style="-fx-pref-height: 38; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-padding: 0 10; -fx-font-size: 13;" />
        </VBox>

        <HBox spacing="10.0">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label text="IP Máy chủ:" textFill="#334155">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>
                <TextField fx:id="txtServerIp" text="127.0.0.1" promptText="127.0.0.1"
                           style="-fx-pref-height: 36; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-padding: 0 10; -fx-font-size: 12;" />
            </VBox>
            <VBox spacing="4.0" prefWidth="100.0">
                <Label text="Cổng (Port):" textFill="#334155">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>
                <TextField fx:id="txtServerPort" text="8888" promptText="8888"
                           style="-fx-pref-height: 36; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-padding: 0 10; -fx-font-size: 12;" />
            </VBox>
        </HBox>

        <!-- Thông báo trạng thái -->
        <Label fx:id="lblStatus" text="" wrapText="true" alignment="CENTER" maxWidth="350.0">
            <font>
                <Font size="12.0" />
            </font>
            <VBox.margin>
                <Insets top="2.0" />
            </VBox.margin>
        </Label>

        <!-- Nút Đăng nhập & Đăng ký -->
        <VBox spacing="8.0">
            <Button fx:id="btnLogin" defaultButton="true" mnemonicParsing="false" onAction="#onLogin"
                    prefHeight="40.0" maxWidth="1.7976931348623157E308"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 13;"
                    text="Đăng Nhập" />
            <Button fx:id="btnRegister" mnemonicParsing="false" onAction="#onRegister"
                    prefHeight="36.0" maxWidth="1.7976931348623157E308"
                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-cursor: hand; -fx-font-size: 12;"
                    text="Đăng Ký Tài Khoản Mới" />
        </VBox>
    </VBox>

    <Label text="Cơ sở dữ liệu: MySQL pbl4_db" textFill="#94a3b8">
        <font>
            <Font size="11.0" />
        </font>
    </Label>

</VBox>
