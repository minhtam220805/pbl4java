<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="580.0" prefWidth="450.0" spacing="16.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pbl4.app.controller.LoginController"
      stylesheets="@../style/theme.css"
      style="-fx-background-color: linear-gradient(to bottom, #f8fafc, #f1f5f9); -fx-padding: 28 36;">

    <!-- Logo & Header -->
    <VBox alignment="CENTER" spacing="6.0">
        <StackPane prefHeight="54.0" prefWidth="54.0" maxWidth="54.0"
                   style="-fx-background-color: linear-gradient(to bottom right, #3b82f6, #1d4ed8); -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(37,99,235,0.35), 10, 0, 0, 4);">
            <Label text="💬" textFill="WHITE">
                <font>
                    <Font size="26.0" />
                </font>
            </Label>
        </StackPane>
        <Label text="PBL4 Chat &amp; P2P" textFill="#0f172a">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>
        <Label text="Trò chuyện bảo mật &amp; Truyền tệp tin ngang hàng" textFill="#64748b">
            <font>
                <Font size="12.0" />
            </font>
        </Label>
    </VBox>

    <!-- Form đăng nhập Card -->
    <VBox spacing="14.0" styleClass="card" style="-fx-padding: 24;">
        
        <VBox spacing="5.0">
            <Label text="Tên đăng nhập (Username):" textFill="#334155">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Label>
            <TextField fx:id="txtUsername" promptText="Nhập tên tài khoản (vd: admin, alice)..."
                       prefHeight="40.0" styleClass="text-field" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="Mật khẩu (Password):" textFill="#334155">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Label>
            <PasswordField fx:id="txtPassword" promptText="Nhập mật khẩu..."
                           prefHeight="40.0" styleClass="password-field" />
        </VBox>

        <HBox spacing="10.0">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label text="IP Máy chủ:" textFill="#334155">
                    <font>
                        <Font name="System Bold" size="11.0" />
                    </font>
                </Label>
                <TextField fx:id="txtServerIp" text="127.0.0.1" promptText="127.0.0.1"
                           prefHeight="36.0" styleClass="text-field" />
            </VBox>
            <VBox spacing="4.0" prefWidth="105.0">
                <Label text="Cổng (Port):" textFill="#334155">
                    <font>
                        <Font name="System Bold" size="11.0" />
                    </font>
                </Label>
                <TextField fx:id="txtServerPort" text="8888" promptText="8888"
                           prefHeight="36.0" styleClass="text-field" />
            </VBox>
        </HBox>

        <!-- Thông báo trạng thái -->
        <Label fx:id="lblStatus" text="" wrapText="true" alignment="CENTER" maxWidth="360.0">
            <font>
                <Font size="12.0" />
            </font>
        </Label>

        <!-- Nút Đăng nhập & Đăng ký -->
        <VBox spacing="9.0">
            <Button fx:id="btnLogin" defaultButton="true" mnemonicParsing="false" onAction="#onLogin"
                    prefHeight="42.0" maxWidth="1.7976931348623157E308"
                    styleClass="button, btn-primary"
                    text="Đăng Nhập 🚀" />
            <Button fx:id="btnRegister" mnemonicParsing="false" onAction="#onRegister"
                    prefHeight="38.0" maxWidth="1.7976931348623157E308"
                    styleClass="button, btn-secondary"
                    text="Đăng Ký Tài Khoản Mới" />
        </VBox>
    </VBox>

    <Label text="🛡️ Mã hóa AES-128 | Băm mật khẩu SHA-256 | MySQL pbl4_db" textFill="#94a3b8">
        <font>
            <Font size="11.0" />
        </font>
    </Label>

</VBox>
