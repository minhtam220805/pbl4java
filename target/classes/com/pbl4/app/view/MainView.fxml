<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1020.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pbl4.app.controller.MainController">

    <!-- Top Bar: Header hiện đại -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="58.0" spacing="15.0"
              style="-fx-background-color: #1e293b; -fx-padding: 10 24;" BorderPane.alignment="CENTER">
            <Label text="PBL4 Chat &amp; P2P Transfer" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
            <Separator orientation="VERTICAL" prefHeight="25.0" style="-fx-opacity: 0.3;" />
            <Label fx:id="lblCurrentUser" text="Tài khoản: ..." textFill="#94a3b8">
                <font>
                    <Font name="System Bold" size="13.0" />
                </font>
            </Label>
            <Label fx:id="lblDbStatus" text="● MySQL: Đã kết nối" textFill="#22c55e">
                <font>
                    <Font size="12.0" />
                </font>
            </Label>
            <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                <!-- Nút dành riêng cho ADMIN (ẩn đối với USER thường) -->
                <Button fx:id="btnAdminPanel" mnemonicParsing="false" onAction="#onOpenAdminPanel"
                        style="-fx-background-color: #f59e0b; -fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 14;"
                        text="👑 Trang Quản Trị" />
                <Button mnemonicParsing="false" onAction="#onOpenSettings"
                        style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 14;"
                        text="⚙ Cài Đặt" />
                <Button mnemonicParsing="false" onAction="#onLogout"
                        style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 14;"
                        text="Đăng Xuất" />
            </HBox>
        </HBox>
    </top>

    <!-- Center: Chia 2 cột -->
    <center>
        <SplitPane dividerPositions="0.27" BorderPane.alignment="CENTER" style="-fx-box-border: transparent;">
            <items>
                <!-- Bên Trái: Danh Sách Phòng Chat & Người Dùng -->
                <VBox spacing="10.0" style="-fx-background-color: #f8fafc; -fx-padding: 14;">
                    <Label text="HỘI THOẠI &amp; BẠN BÈ" textFill="#475569">
                        <font>
                            <Font name="System Bold" size="12.0" />
                        </font>
                    </Label>
                    
                    <!-- Danh sách người dùng và phòng chat -->
                    <ListView fx:id="lvChatTargets" VBox.vgrow="ALWAYS"
                              style="-fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-control-inner-background: #ffffff;" />
                    
                    <VBox spacing="4.0" style="-fx-background-color: #f1f5f9; -fx-padding: 8 10; -fx-background-radius: 6;">
                        <Label text="💡 Hướng dẫn:" textFill="#334155">
                            <font>
                                <Font name="System Bold" size="11.0" />
                            </font>
                        </Label>
                        <Label text="- Bấm 'Phòng Chat Chung' để chat nhóm." textFill="#64748b">
                            <font><Font size="11.0" /></font>
                        </Label>
                        <Label text="- Chọn 1 người dùng để chat riêng &amp; gửi file P2P." textFill="#64748b">
                            <font><Font size="11.0" /></font>
                        </Label>
                    </VBox>
                </VBox>

                <!-- Bên Phải: Toàn bộ khu vực Chat & Truyền File P2P -->
                <VBox spacing="12.0" style="-fx-background-color: #ffffff; -fx-padding: 16;">
                    
                    <!-- Header của phòng chat đang chọn -->
                    <HBox alignment="CENTER_LEFT" spacing="10.0"
                          style="-fx-background-color: #f1f5f9; -fx-padding: 10 14; -fx-background-radius: 8;">
                        <Label fx:id="lblChatHeader" text="💬 Đang trò chuyện: Phòng Chat Chung (ALL)" textFill="#1e293b" HBox.hgrow="ALWAYS">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblHistoryStatus" text="⬆ Cuộn chuột lên đỉnh để tải tin nhắn cũ" textFill="#64748b">
                                <font>
                                    <Font size="11.0" />
                                </font>
                            </Label>
                        </HBox>
                    </HBox>

                    <!-- Danh sách tin nhắn chat (ListView hỗ trợ Scroll Lazy Loading) -->
                    <ListView fx:id="lvChatMessages" VBox.vgrow="ALWAYS"
                              style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-control-inner-background: #fbfcfd;" />

                    <!-- Khung soạn thảo tin nhắn -->
                    <HBox spacing="10.0">
                        <TextField fx:id="txtMessage" promptText="Nhập nội dung tin nhắn..." HBox.hgrow="ALWAYS"
                                   style="-fx-pref-height: 40; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-padding: 0 12; -fx-font-size: 13;" />
                        <Button fx:id="btnSend" defaultButton="true" mnemonicParsing="false" onAction="#onSendMessage"
                                prefHeight="40.0" prefWidth="95.0"
                                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 13;"
                                text="Gửi ✉" />
                    </HBox>

                    <!-- Khu vực truyền File P2P -->
                    <VBox spacing="10.0" style="-fx-background-color: #f8fafc; -fx-padding: 14; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="Truyền File Ngang Hàng (P2P File Transfer):" textFill="#1e293b">
                                <font>
                                    <Font name="System Bold" size="13.0" />
                                </font>
                            </Label>
                            <Label fx:id="lblTargetReceiver" text="(Đối tác nhận: ALL)" textFill="#2563eb">
                                <font>
                                    <Font name="System Bold" size="12.0" />
                                </font>
                            </Label>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Button fx:id="btnChooseFile" mnemonicParsing="false" onAction="#onChooseFile"
                                    style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 12;"
                                    text="📁 Chọn File" />
                            <Button fx:id="btnChooseFolder" mnemonicParsing="false" onAction="#onChooseFolder"
                                    style="-fx-background-color: #0d9488; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 12;"
                                    text="📂 Chọn Thư Mục" />
                            <Button fx:id="btnSendFile" mnemonicParsing="false" onAction="#onSendFileP2P"
                                    style="-fx-background-color: #ea580c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 14;"
                                    text="🚀 Gửi P2P Ngay" />
                        </HBox>

                        <Label fx:id="lblSelectedFile" text="Chưa chọn tệp tin hoặc thư mục nào." textFill="#64748b">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>

                        <!-- Thanh Tiến Trình (ProgressBar) -->
                        <ProgressBar fx:id="progressBar" maxWidth="1.7976931348623157E308" prefHeight="16.0" progress="0.0"
                                     style="-fx-accent: #10b981;" />

                        <Label fx:id="lblProgressStatus" text="Trạng thái P2P: Sẵn sàng." textFill="#64748b">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                    </VBox>

                </VBox>
            </items>
        </SplitPane>
    </center>
</BorderPane>
